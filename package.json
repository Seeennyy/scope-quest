{
  "name": "scope-quest",
  "version": "1.0.0",
  "description": "Scope Quest: live GHG lecture game (Nile Loaf)",
  "scripts": {
    "dev": "npm run build && node dist/server.cjs",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --packages=external",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p .",
    "test:engine": "tsx tests/engine.test.ts",
    "test:load": "tsx tests/load.ts",
    "test:restart": "tsx tests/restart.ts",
    "test:e2e": "tsx tests/e2e.ts"
  },
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}