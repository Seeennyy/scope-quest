# Copy to .env and fill in. Never commit .env.
DOMAIN=ghg.yourdomain.com
PUBLIC_URL=https://ghg.yourdomain.com
# Long random string: it is the secret part of the host link (/host?k=...). Generate: openssl rand -hex 16
HOST_KEY=change-me-to-a-long-random-string
# PIN the instructor types on /host and /admin
HOST_PIN=2468
